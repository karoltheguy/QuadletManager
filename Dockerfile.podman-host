# A real Podman 5 host, over SSH, with real systemd and a real quadlet generator.
#
# This exists alongside Dockerfile.test.systemd rather than replacing it. That
# image (Ubuntu 22.04 + systemd + sshd, no podman) backs the `integration`
# suite; changing it would ripple into tests unrelated to this one.
#
# Fedora is the base because it ships podman 5 and the quadlet generator in the
# distro packages, so the version is pinned by the base image tag rather than by
# a third-party repo. The build asserts the major version below, so bumping
# FEDORA_VERSION can never silently drop back to podman 4.
ARG FEDORA_VERSION=43
FROM registry.fedoraproject.org/fedora:${FEDORA_VERSION}

# iptables-nft, netavark and aardvark-dns are what podman actually uses for
# container networking on Fedora; without them `podman run` fails at network
# setup rather than at image pull, which is a confusing place to debug.
# skopeo is build-time only: it copies images without needing a container
# runtime, which a build layer cannot have (see the image preload below).
# util-linux (for `runuser`, which load-test-image.sh needs to reach the
# rootless image store) and libcap (for `setcap`, below) are listed explicitly
# rather than relied on as transitive dependencies of something else.
RUN dnf install -y \
        systemd \
        openssh-server \
        sudo \
        shadow-utils \
        podman \
        crun \
        fuse-overlayfs \
        iptables-nft \
        netavark \
        aardvark-dns \
        catatonit \
        skopeo \
        procps-ng \
        util-linux \
        libcap \
    && dnf clean all

# Guard the whole premise of this image. If a base bump ever ships podman 4,
# fail the build loudly here instead of failing every podman test mysteriously.
RUN podman --version | grep -Eq 'version 5\.' || (podman --version; exit 1) \
    && podman --version > /etc/podman-version

# Restore the file capabilities on newuidmap/newgidmap.
#
# The host RPM ships /usr/bin/newuidmap with cap_setuid=ep, but Fedora's
# *container* base image does not: getcap returns empty inside a freshly pulled
# fedora:43, rootless and rootful alike. Nothing warns about it at build time.
#
# Without these, rootless podman inside this container fails with
#   "cannot set up namespace using /usr/bin/newuidmap:
#    should have setuid or have filecaps setuid"
# which reads like a broken linger setup and points nowhere near the image.
# Since the rootless (`user`) scope is half of what this suite exists to cover,
# that failure would take out `test_quadlet_lifecycle_user.py` and the rootless
# half of the validator and stats tests.
#
# Verified as the actual root cause on 2026-07-31, after first misdiagnosing it
# as a rootless-build xattr-stripping problem.
RUN setcap cap_setuid+ep /usr/bin/newuidmap \
    && setcap cap_setgid+ep /usr/bin/newgidmap \
    && getcap /usr/bin/newuidmap | grep -q cap_setuid \
    && getcap /usr/bin/newgidmap | grep -q cap_setgid \
    || ( echo "could not set file capabilities on newuidmap/newgidmap;"; \
         echo "rootless podman inside this container will not work."; \
         exit 1 )

# The quadlet generator is the reason this image exists: it is what
# services/quadlet_validator.py shells out to, and what has never been
# exercised for real. Fail now if the podman package stopped shipping it.
RUN test -x /usr/lib/systemd/system-generators/podman-system-generator \
    || test -x /usr/libexec/podman/quadlet \
    || (echo "no quadlet generator at either _GENERATOR_PATHS entry"; exit 1)

# 'editor' with passwordless sudo, matching Dockerfile.test.systemd so the two
# fake hosts are interchangeable from the test's point of view. The uid is
# pinned because the linger and image-preload units below refer to /run/user/1000.
RUN useradd -m -u 1000 -s /bin/bash editor \
    && echo "editor:password" | chpasswd \
    && usermod -aG wheel editor \
    && echo "editor ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers \
    && install -d -m 700 -o editor -g editor /home/editor/.ssh

# sudo has to work, and on a GitHub runner the stock PAM stack refuses it:
#
#   sudo: PAM account management error: Authentication service cannot retrieve
#         authentication info
#   sudo: a password is required
#
# Third service on this host to fail the same way, after user@.service and
# sshd, and the most damaging of the three. Every global-scope test reaches the
# host through use_sudo=True, and services/remote_fs.py writes
# /etc/containers/systemd that way, so without sudo it is not one broken test
# but half the suite. NOPASSWD is already granted above, so this is not an
# authentication failure: sudo never asks for a password, it fails the
# *account* stage before getting that far.
#
# The replacement stack grants exactly what the sudoers line above already
# grants, so nothing about this container's security posture changes. Verified
# against fedora:43 that it does not regress where the stock stack works.
RUN printf '%s\n' \
        'auth       sufficient   pam_rootok.so' \
        'auth       required     pam_permit.so' \
        'account    required     pam_permit.so' \
        'session    required     pam_permit.so' \
    > /etc/pam.d/sudo \
    && runuser -u editor -- sudo -n true \
    || ( echo "sudo is refused inside this image; every global-scope test would fail"; \
         runuser -u editor -- sudo -n true; \
         exit 1 )

COPY tests/fixtures/test_key.pub /home/editor/.ssh/authorized_keys
RUN chown editor:editor /home/editor/.ssh/authorized_keys \
    && chmod 600 /home/editor/.ssh/authorized_keys

# Keep nss-systemd out of group lookups, and leave PAM alone entirely.
#
# On a GitHub runner, but never under local podman, PAM's *account* stage
# failed for three different services on this image, each visible only once the
# previous was fixed:
#
#   user@1000.service: PAM failed: Authentication service cannot retrieve
#                      authentication info                    (status=224/PAM)
#   sshd:              Access denied for user editor by PAM account
#                      configuration [preauth]   (after accepting the key)
#   sudo:              PAM account management error: Authentication service
#                      cannot retrieve authentication info
#
# All three are PAM_AUTHINFO_UNAVAIL, and the suspects that usually cause it
# are not even in this stack: `authselect current` on fedora:43 reports the
# `local` profile, whose entire account stage is `account required pam_unix.so`.
# No sssd, no faillock, no sepermit.
#
# What is unusual is nsswitch.conf. `passwd` and `shadow` are `files systemd`,
# which stops at the first success, so a real local account never reaches
# nss-systemd. `group` is `files [SUCCESS=merge] systemd`, and merge means
# nss-systemd is consulted on *every* group lookup and can never short-circuit.
# That puts a Varlink round trip to systemd-userdbd in the path of pam_unix's
# account phase, of sshd building supplementary groups, and of sudo's own group
# check. If that call errors rather than returning "not found", the caller
# reports exactly the message above. It also explains why `runuser` worked
# throughout: its stack does not make that lookup where it matters.
#
# This fixture has no systemd dynamic users to resolve, so nothing needs
# nss-systemd for groups. Dropping it is smaller than any PAM surgery and, if
# the theory holds, removes the cause of all three failures rather than opting
# each service out of PAM one at a time. The readiness gate prints
# `getent group editor` and systemd-userdbd's state so the next run can confirm
# or refute this rather than leaving it a good story.
#
# Consequence worth stating: sshd therefore keeps Fedora's stock PAM stack.
# That matters beyond auth. pam_systemd is what exports XDG_RUNTIME_DIR into an
# ssh session, and services/systemd_manager.py's systemctl_action runs a bare
# `systemctl --user`, relying on the session to provide it exactly as a real
# host does. An earlier attempt here set `UsePAM no`, which fixed the login and
# then broke every user-scope test with "Failed to connect to user scope bus:
# $XDG_RUNTIME_DIR not defined". A test host that needs PAM disabled is no
# longer the real host this suite exists to exercise.
RUN sed -i 's/^group:.*/group:      files/' /etc/nsswitch.conf \
    && grep -q '^group:      files$' /etc/nsswitch.conf \
    && systemctl enable sshd

# Linger. `loginctl enable-linger` needs a running systemd, which a build layer
# does not have, so create the marker file it would have written.
#
# This is the single most load-bearing line in the file. Without it there is no
# /run/user/1000, so ROOTLESS_ENV_PREFIX ('XDG_RUNTIME_DIR=/run/user/$(id -u)')
# points at nothing and every rootless systemctl over non-interactive SSH
# returns empty output instead of an error. tests/podman/test_podman_host_env.py
# is the canary for exactly this.
RUN mkdir -p /var/lib/systemd/linger && touch /var/lib/systemd/linger/editor

# Stop the user manager from demanding a PAM session.
#
# Linger alone is not enough. user@.service runs `systemd --user` through the
# `systemd-user` PAM stack, and inside a container on a host with audit enabled
# that stack cannot complete. Observed on a GitHub runner (PR #284, run
# 30657079978):
#
#   user@1000.service: PAM failed: Authentication service cannot retrieve
#                      authentication info
#   user@1000.service: Failed to set up PAM session: Operation not permitted
#   user@1000.service: Failed at step PAM spawning /usr/lib/systemd/systemd
#   user@1000.service: Main process exited, status=224/PAM
#
# The failure is environment-dependent, which is the worst property it could
# have: the identical image boots clean under local rootful podman and fails
# under the runner's Docker, so the two targets disagree on the same commit.
# `pam_loginuid.so` cannot write /proc/self/loginuid there, and the account
# lookup is the other half of the message.
#
# `PAMName=` (empty) resets the setting, so no PAM session is set up at all.
# Nothing here needs one: linger plus user-runtime-dir@.service already create
# /run/user/1000, which is the only thing ROOTLESS_ENV_PREFIX depends on. A
# session bus the user manager would otherwise provide is what rootless podman
# complains about losing ("could not determine address of session bus"), and
# that returns with the manager.
#
# XDG_RUNTIME_DIR has to be set here for the same reason. It is normally
# pam_systemd, reached through the systemd-user PAM stack, that exports it into
# the manager's environment; user@.service itself sets no such variable. Drop
# PAM without replacing it and `systemd --user` starts, finds no runtime
# directory and exits 1 immediately, logging nothing to the system journal.
# That was the second failure on the same run, and it looks nothing like the
# first: status=1/FAILURE with no message at all.
#
# %i is the uid for this template, so this resolves to the directory
# user-runtime-dir@.service has already created.
#
# Applied to the template, not user@1000.service, so it survives a uid change.
RUN mkdir -p /etc/systemd/system/user@.service.d \
    && printf '%s\n' \
        '[Service]' \
        'PAMName=' \
        'Environment=XDG_RUNTIME_DIR=/run/user/%i' \
    > /etc/systemd/system/user@.service.d/10-no-pam.conf

# These four mount kernel pseudo-filesystems that a container cannot have, so
# they always fail and always leave `systemctl is-system-running` at "degraded".
# Masking them means the readiness gate can insist on a clean "running" and a
# genuine boot failure is not hidden in the noise.
RUN systemctl mask \
        proc-sys-fs-binfmt_misc.automount \
        sys-kernel-config.mount \
        sys-kernel-debug.mount \
        sys-kernel-tracing.mount

# Nested storage. The host's own container filesystem is already overlay, and
# native overlay-on-overlay is refused by the kernel, so both stores must go
# through fuse-overlayfs. Symptom when this is missing: a storage-driver error
# on the very first `podman run`, rootless and rootful alike.
#
# chown -R on .config rather than `install -d -o editor`: install applies
# ownership only to the last path component, leaving .config itself root-owned,
# and rootless podman refuses to start on a config dir it does not own.
RUN printf '%s\n' \
        '[storage]' \
        'driver = "overlay"' \
        'runroot = "/run/containers/storage"' \
        'graphroot = "/var/lib/containers/storage"' \
        '[storage.options]' \
        'mount_program = "/usr/bin/fuse-overlayfs"' \
    > /etc/containers/storage.conf \
    && mkdir -p /home/editor/.config/containers \
    && printf '%s\n' \
        '[storage]' \
        'driver = "overlay"' \
        '[storage.options]' \
        'mount_program = "/usr/bin/fuse-overlayfs"' \
    > /home/editor/.config/containers/storage.conf \
    && chown -R editor:editor /home/editor/.config

# The global quadlet directory services/remote_fs.py writes to. Podman creates
# it lazily on some builds; the tests assume it is there.
RUN install -d -m 755 /etc/containers/systemd

# Move the nested default network off 10.88.0.0/16.
#
# That is podman's default for the rootful scope both outside and inside this
# container. The first global-scope quadlet to start makes nested podman create
# podman0 on the same subnet the container's own address belongs to, which
# blackholes its route back to the host: sshd keeps listening, the published
# port keeps accepting, and every new connection fails with "No route to host".
# The test host then looks dead while nothing has actually crashed.
#
# 10.201.0.0/16 is chosen to sit clear of both that default and of the
# 10.203.51.0/24 used by tests/fixtures/quadlets/e2e-test.network.
RUN install -d -m 755 /etc/containers/containers.conf.d \
    && printf '%s\n' \
        '[network]' \
        'default_subnet = "10.201.0.0/16"' \
    > /etc/containers/containers.conf.d/99-nested-subnet.conf

# Preload the test image at build time. skopeo needs no container runtime, so
# this works in a build layer where `podman pull` would not. docker-archive
# (rather than oci-archive) is used because it carries the repo tag through
# `podman load`, so the fixtures can reference the image by name.
#
# quay.io throughout, not docker.io: anonymous docker.io pulls are rate-limited
# and CI shares an IP with every other runner.
RUN skopeo copy \
        docker://quay.io/quay/busybox:latest \
        docker-archive:/opt/test-image.tar:quay.io/quay/busybox:latest

# Rootless and rootful have entirely separate image stores, so the archive has
# to be loaded twice. Doing it at boot rather than at build time keeps the
# build unprivileged; doing it at all keeps a network pull out of every test run.
COPY tests/fixtures/podman-host/load-test-image.sh /usr/local/bin/load-test-image.sh
COPY tests/fixtures/podman-host/load-test-image.service /etc/systemd/system/load-test-image.service
RUN chmod 755 /usr/local/bin/load-test-image.sh \
    && systemctl enable load-test-image.service

EXPOSE 22
CMD ["/usr/sbin/init"]
