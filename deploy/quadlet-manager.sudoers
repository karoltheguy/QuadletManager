# QuadletManager: the sudo grants the agent account needs for global scope.
#
# This file is the single source of the allowlist. Everything that installs
# these rules reads it: scripts/podman-e2e.sh for the loopback test target,
# Dockerfile.podman-host for the container target's `narrow` account, and you,
# on a real server. docs/SETUP.MD reproduces it for readers, and
# tests/test_sudo_allowlist_sync.py fails if that copy drifts from this one.
#
# Install it with the agent's account name substituted for %AGENT%:
#
#   sed 's/%AGENT%/quadlet-agent/' deploy/quadlet-manager.sudoers \
#     | sudo tee /etc/sudoers.d/quadlet-manager >/dev/null
#   sudo chmod 440 /etc/sudoers.d/quadlet-manager
#   sudo visudo -cf /etc/sudoers.d/quadlet-manager
#
# Rootless (user) scope needs no sudo at all. These rules are global scope only.
#
# The terminal tab (podman exec) is deliberately not granted here. See
# docs/SUDO_PERMISSIONS.md for why.
#
# Scope every path rule to /etc/containers/systemd/*. This is still the
# right habit and it does narrow the surface, but it is not by itself
# confinement: sudo matches command arguments against that glob with
# fnmatch and *without* FNM_PATHNAME, so the * matches / too, and a
# caller-supplied .. segment walks straight back out of the directory.
# What actually confines a caller-supplied path before it reaches a
# command here is services.remote_fs.ensure_within_quadlet_dir. See
# docs/SUDO_PERMISSIONS.md for the detail.

# Reload units after a write, and drive the units themselves.
%AGENT% ALL=(ALL) NOPASSWD: /usr/bin/systemctl daemon-reload
%AGENT% ALL=(ALL) NOPASSWD: /usr/bin/systemctl start *
%AGENT% ALL=(ALL) NOPASSWD: /usr/bin/systemctl stop *
%AGENT% ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart *
%AGENT% ALL=(ALL) NOPASSWD: /usr/bin/systemctl status *
%AGENT% ALL=(ALL) NOPASSWD: /usr/bin/systemctl show *
%AGENT% ALL=(ALL) NOPASSWD: /usr/bin/journalctl -u *

# Write quadlet files, and nothing outside the quadlet directory.
%AGENT% ALL=(ALL) NOPASSWD: /usr/bin/tee /etc/containers/systemd/*
%AGENT% ALL=(ALL) NOPASSWD: /usr/bin/rm -f /etc/containers/systemd/*

# List and read what's already on disk.
%AGENT% ALL=(ALL) NOPASSWD: /usr/bin/find /etc/containers/systemd -type f -maxdepth 1
%AGENT% ALL=(ALL) NOPASSWD: /usr/bin/cat /etc/containers/systemd/*

# Two literal stat shapes rather than one -c * rule, so the format string
# can't be anything a caller likes: a single path, and a batch form.
%AGENT% ALL=(ALL) NOPASSWD: /usr/bin/stat -c %Y /etc/containers/systemd/*
%AGENT% ALL=(ALL) NOPASSWD: /usr/bin/stat -c %n\ %Y /etc/containers/systemd/*

# The only shape this call site ever emits, so no wildcard is needed.
%AGENT% ALL=(ALL) NOPASSWD: /usr/bin/mkdir -p /etc/containers/systemd

# Read resource usage for global-scope containers.
%AGENT% ALL=(ALL) NOPASSWD: /usr/bin/podman stats *

# List running containers. Also the only shape this call site emits.
%AGENT% ALL=(ALL) NOPASSWD: /usr/bin/podman ps --format json

# Drive global-scope pods.
%AGENT% ALL=(ALL) NOPASSWD: /usr/bin/podman pod start *
%AGENT% ALL=(ALL) NOPASSWD: /usr/bin/podman pod stop *
%AGENT% ALL=(ALL) NOPASSWD: /usr/bin/podman pod restart *
