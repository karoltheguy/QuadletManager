          "fingerprints": {
            "matchBasedId/v1": "140e52f72933abb7857b9bdfb14124bdce03a4f0f46ad64d0af5233606c3251d12264f04beaaef4307b40a09a9cf2e7365b02bcfdcbff280685b56ab5bc8263c_0"
